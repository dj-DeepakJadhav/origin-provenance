# =============================================================================
# ORIGIN — configuration
#
# There are TWO submission profiles. They run the same code; the difference is
# whether AWS is involved at all.
#
#   DataHub submission  — requires a DataHub component, nothing else.
#                         ORIGIN_PROVIDER=local   ORIGIN_STORAGE=local
#                         No AWS account, no credentials, fully offline.
#
#   CockroachDB submission — requires at least one AWS service.
#                         ORIGIN_PROVIDER=bedrock ORIGIN_STORAGE=s3
#
# Neither is a lesser build. The ledger, the point-in-time queries, the policy
# gate and the takedown impact query are identical in both. What changes is
# where document bytes live and who classifies novel licence strings.
# =============================================================================

# --- CockroachDB (agent memory) — required in both profiles ------------------
# From CockroachDB Cloud: Cluster > Connect > "General connection string".
#
# Append `&sslrootcert=system`. The string Cockroach hands you ends at
# `sslmode=verify-full`, and libpq then looks for a CA bundle at
# %APPDATA%\postgresql\root.crt (or ~/.postgresql/root.crt) which does not
# exist, so the connection fails with "root certificate file does not exist".
#
# `sslrootcert=system` uses the OS trust store. CockroachDB Cloud certificates
# are publicly trusted, so this keeps FULL verification. Do NOT reach for
# sslmode=require or =disable to get past that error — that turns off the
# verification rather than supplying the roots.
#
# Point the database at `origin`, not `defaultdb` — sql/001 creates it.
DATABASE_URL=postgresql://user:password@host:26257/origin?sslmode=verify-full&sslrootcert=system

# --- DataHub (context graph) — required in both profiles ---------------------
# Local quickstart default. Token only needed if metadata auth is enabled.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# --- Model provider ---------------------------------------------------------
# local   = rule-based licence classification + hashed-ngram embeddings.
#           Deterministic, offline, no credentials. Genuinely functional: the
#           recall path that matches cosmetically-different licence strings
#           works without any model.
# bedrock = Amazon Bedrock. Improves classification of NOVEL licence strings.
ORIGIN_PROVIDER=local

# --- Document storage -------------------------------------------------------
# local = filesystem. s3 = Amazon S3.
ORIGIN_STORAGE=local
ORIGIN_STORAGE_PATH=data/documents

# Only read when ORIGIN_STORAGE=s3.
ORIGIN_S3_BUCKET=
ORIGIN_S3_PREFIX=origin/documents

# --- AWS (CockroachDB submission profile only) ------------------------------
# Bedrock grants model access per-model per-region and it is not instant.
# Request Claude and Titan Embed in the Bedrock console before switching over.
AWS_REGION=us-east-1
BEDROCK_TEXT_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Embedding width. Must match the VECTOR(n) columns in sql/001_schema.sql.
# Titan v2 supports 256/512/1024. The local provider matches whatever is set.
ORIGIN_EMBED_DIM=1024
